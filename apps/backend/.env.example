PORT=3001
ADMIN_PASSWORD=admin123
JWT_SECRET=til-secret-key-change-in-production

# CORS (쉼표로 구분된 origin 리스트)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Postgres (Supabase를 DB 호스팅으로 쓸 때: Project Settings → Database → Connection string URI)
DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
