{
  "name": "til",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "prepare": "turbo run build --filter=@til/shared --filter=@til/ui",
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=@til/backend",
    "dev:frontend-admin": "turbo run dev --filter=@til/frontend-admin",
    "dev:frontend-web": "turbo run dev --filter=@til/frontend-web",
    "build": "turbo run build",
    "build:backend": "turbo run build --filter=@til/backend",
    "build:frontend-admin": "turbo run build --filter=@til/frontend-admin",
    "build:frontend-web": "turbo run build --filter=@til/frontend-web"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
