{
  "name": "til",
  "private": true,
  "scripts": {
    "prepare": "pnpm --filter @til/shared build",
    "dev": "pnpm --filter @til/shared build && pnpm -r --parallel run dev --filter '@til/api' --filter '@til/public' --filter '@til/admin' --filter '@til/shared'",
    "dev:api": "pnpm --filter @til/api dev",
    "dev:public": "pnpm --filter @til/public dev",
    "dev:admin": "pnpm --filter @til/admin dev",
    "build": "pnpm -r run build",
    "build:api": "pnpm --filter @til/api build",
    "build:public": "pnpm --filter @til/public build",
    "build:admin": "pnpm --filter @til/admin build"
  },
  "engines": {
    "node": ">=18"
  }
}
